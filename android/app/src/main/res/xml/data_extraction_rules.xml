<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 排除敏感數據 -->
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </cloud-backup>
    
    <device-transfer>
        <!-- 設備轉移時的規則 -->
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </device-transfer>
</data-extraction-rules>
